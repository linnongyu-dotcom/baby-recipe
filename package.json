{
  "name": "trae-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test:lunch-rules": "node scripts/run-ts-test.mjs test/lunch-rules.test.ts && node scripts/run-ts-test.mjs test/lunch-independent-meat-rules.test.ts",
    "test:meal-rules": "node scripts/run-ts-test.mjs test/meal-rules.test.ts && node test/cache-bootstrap.test.mjs",
    "test:dinner-rules": "node scripts/run-ts-test.mjs test/dinner-rules.test.ts",
    "test:vegetable-rules": "node scripts/run-ts-test.mjs test/vegetable-rules.test.ts",
    "test:meal-refresh-rules": "node scripts/run-ts-test.mjs test/meal-refresh-rules.test.ts",
    "test:breakfast-rules": "node scripts/run-ts-test.mjs test/breakfast-rules.test.ts",
    "test:meal-stress": "node scripts/run-ts-test.mjs test/meal-generation-stress.test.ts",
    "test:recipe-data": "node scripts/run-ts-test.mjs test/recipe-data.test.ts",
    "test:meal-all": "npm run test:meal-rules && npm run test:breakfast-rules && npm run test:lunch-rules && npm run test:dinner-rules && npm run test:vegetable-rules && npm run test:meal-refresh-rules && npm run test:meal-stress && npm run test:weekly-plan-audit && node scripts/run-ts-test.mjs test/test-generator.ts && node scripts/run-ts-test.mjs test/test-self-audit.ts && node scripts/run-ts-test.mjs test/test-daily-meal-plan.ts",
    "test:weekly-plan-audit": "node scripts/run-ts-test.mjs test/weekly-plan-audit.test.ts",
    "audit:meal-plans": "node scripts/run-ts-test.mjs scripts/audit-meal-plans.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.6.4",
    "@cloudbase/manager-node": "^5.6.4",
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
